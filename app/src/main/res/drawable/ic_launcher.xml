<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E62117" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <inset android:insetLeft="12dp" android:insetTop="12dp" android:insetRight="12dp" android:insetBottom="12dp">
            <bitmap android:src="@android:drawable/ic_media_play" android:gravity="center" />
        </inset>
    </item>
</layer-list>